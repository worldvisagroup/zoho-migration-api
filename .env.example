# Application Server Configuration
PORT=5050
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/zoho_crm
MONGODB_DB_NAME=zoho_crm

# Security & Throttling
CORS_ORIGIN=*
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Structured Logging Level (debug | log | warn | error)
LOG_LEVEL=log

# Swagger OpenAPI Documentation
SWAGGER_ENABLED=true

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
R2_EXPIRES_IN=3600
